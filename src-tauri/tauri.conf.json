{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clade",
  "mainBinaryName": "clade-gui",
  "version": "0.2.0",
  "identifier": "dev.xanerix.clade",
  "build": {
    "beforeDevCommand": "bun --bun vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "beforeBundleCommand": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin clade",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "clade",
        "width": 1200,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "target/release/clade.exe": "clade.exe"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
